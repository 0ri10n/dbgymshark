# Development environment (local, no Mongo dependency)
PORT=4000

# Frontend wiring
FRONTEND_TARGET=react
VITE_API_URL=http://localhost:4000/api

# Run backend without Mongo errors
ALLOW_START_WITHOUT_DB=true
USE_MOCK_DATA=true
USE_STATIC_EXCHANGE_RATE=true
DEV_MXN_RATE=17.2

# Optional Mongo URI for future use (ignored when USE_MOCK_DATA=true)
MONGO_URI=mongodb://127.0.0.1:27017/makia_dev
PRODUCT_DB=DB
PRODUCT_COLLECTION=productos

# JWT/Auth for local mode
JWT_SECRET=dev_local_secret_change_me
DEV_AUTH_BYPASS=true
DEV_ADMIN_EMAIL=admin@makia.local
DEV_ADMIN_PASSWORD=admin12345
DEV_CLIENT_EMAIL=cliente@makia.local
DEV_CLIENT_PASSWORD=cliente12345

# Not used in static rate mode, kept for compatibility
EXCHANGE_API_KEY=dev
